// Browser test of the theme switcher of the demo decks (examples/layers + examples/components, not part of the theme packages).
// It builds two decks the way the Pages workflow does (base /slide.ng-themes/<name>/, hash router), serves them from a
// temporary folder and checks the pill, the menu, the keyboard, the jump to the other deck with the slide number, and print.
import { execFileSync } from 'node:child_process';
import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, statSync, writeFileSync } from 'node:fs';
import http from 'node:http';
import { tmpdir } from 'node:os';
import { extname, join, resolve } from 'node:path';
import { pathToFileURL } from 'node:url';

const root = resolve(import.meta.dirname, '..');
const core = resolve(process.env.SLIDE_NG_DIR ?? join(root, '../slide.ng'));
const bin = join(core, 'bin/slide-ng.mjs');
if (!existsSync(bin))
  throw new Error(`slide.ng was not found at ${core}. Set SLIDE_NG_DIR to a checkout of slide.ng.`);
const { launch, reporter } = await import(pathToFileURL(join(core, 'tests/e2e/browser.mjs')).href);
const { makeContext } = await import(pathToFileURL(join(core, 'tests/e2e/helpers.mjs')).href);

const NAMES = ['adev', 'seriph', 'shibainu', 'bricks', 'apple-basic'];
const BUILT = ['seriph', 'shibainu'];
const BASE = '/slide.ng-themes';

const t = reporter();
const scratch = mkdtempSync(join(tmpdir(), 'slide-ng-demo-switcher-'));
const site = join(scratch, 'site');
const env = {
  ...process.env,
  CHROME_PATH: process.env.CHROME_PATH ?? '/opt/pw-browsers/chromium-1194/chrome-linux/chrome',
};
if (!existsSync(join(root, 'node_modules/@slide-ng/theme-seriph')))
  throw new Error('Run npm install first: it links the packages into node_modules/@slide-ng.');

for (const name of BUILT) {
  const deck = join(root, 'examples', `_switcher-${name}.md`);
  const text = readFileSync(join(root, 'examples', `${name}.md`), 'utf8');
  writeFileSync(deck, text.replace(/\n/, '\nrouterMode: hash\n'));
  try {
    execFileSync(
      process.execPath,
      [bin, 'build', deck, '--base', `${BASE}/${name}/`, '--out', join(site, BASE.slice(1), name)],
      { stdio: 'inherit', env },
    );
  } finally {
    rmSync(deck, { force: true });
  }
}

// A static server that answers /slide.ng-themes/<name>/ with that folder's index.html.
const types = { '.js': 'text/javascript', '.css': 'text/css', '.html': 'text/html', '.json': 'application/json' };
const server = http.createServer((req, res) => {
  let file = join(site, decodeURIComponent(req.url.split('?')[0]));
  if (existsSync(file) && statSync(file).isDirectory()) file = join(file, 'index.html');
  if (!existsSync(file)) {
    res.statusCode = 404;
    res.end('not found');
    return;
  }
  res.setHeader('content-type', types[extname(file)] ?? 'application/octet-stream');
  res.end(readFileSync(file));
});
await new Promise((done) => server.listen(0, done));
const origin = `http://localhost:${server.address().port}`;

const browser = await launch();
try {
  const ctx = makeContext(origin, browser, t);
  const setup = (page) =>
    page.route('**/fonts.googleapis.com/**', (route) =>
      route.fulfill({ status: 200, contentType: 'text/css', body: '' }),
    );
  const open = (name, no) => ctx.open(`${BASE}/${name}/#/${no}`, undefined, setup);
  const pill = (page) => page.locator('.demo-switcher-pill');
  const items = (page) => page.locator('.demo-switcher-item');
  const where = (page) => {
    const u = new URL(page.url());
    return u.pathname + u.hash;
  };
  const focused = (page) =>
    page.evaluate(() => document.activeElement?.textContent?.trim() ?? document.activeElement?.tagName);

  const page = await open('seriph', 3);
  t.ok('the pill shows the theme name', (await pill(page).innerText()).trim() === 'seriph');
  t.ok(
    'the pill has an accessible name and is collapsed',
    /seriph/.test((await pill(page).getAttribute('aria-label')) ?? '') &&
      (await pill(page).getAttribute('aria-expanded')) === 'false' &&
      (await pill(page).getAttribute('aria-haspopup')) === 'menu',
  );
  const box = await pill(page).boundingBox();
  t.ok('the pill is small and in the top left corner', box.width < 120 && box.height < 40 && box.y < 80);

  await pill(page).click();
  t.ok('a click opens a menu with the five themes', (await items(page).count()) === 5);
  t.ok(
    'the entries are the five themes and the current one is marked',
    (await items(page).allInnerTexts()).map((s) => s.trim()).join() === NAMES.join() &&
      (await items(page).nth(1).getAttribute('aria-current')) === 'true',
  );
  t.ok('the menu has the menu role', (await page.locator('[role=menu] [role=menuitem]').count()) === 5);
  t.ok('using the pill does not move the slide', where(page) === `${BASE}/seriph/#/3`);
  await page.keyboard.press('Escape');
  t.ok('Escape closes the menu', (await items(page).count()) === 0);
  t.ok('Escape gives the focus back to the pill', (await focused(page)) === 'seriph');

  await pill(page).focus();
  await ctx.press(page, 'Enter');
  t.ok('Enter on the pill opens the menu on the current theme', (await focused(page)) === 'seriph' && (await items(page).count()) === 5);
  await ctx.press(page, 'ArrowDown');
  t.ok('ArrowDown moves to the next entry', (await focused(page)) === 'shibainu');
  await ctx.press(page, 'ArrowUp');
  await ctx.press(page, 'ArrowUp');
  t.ok('ArrowUp moves up', (await focused(page)) === 'adev');
  await ctx.press(page, 'ArrowUp');
  t.ok('ArrowUp wraps to the last entry', (await focused(page)) === 'apple-basic');
  await ctx.press(page, 'Home');
  t.ok('Home goes to the first entry', (await focused(page)) === 'adev');
  await ctx.press(page, 'End');
  t.ok('End goes to the last entry', (await focused(page)) === 'apple-basic');
  t.ok('the arrow keys did not move the slide', where(page) === `${BASE}/seriph/#/3`);
  const ring = await items(page).last().evaluate((e) => getComputedStyle(e).outlineStyle);
  t.ok('the focused entry has a focus ring', ring === 'solid');

  await page.mouse.click(600, 400);
  t.ok('a click outside closes the menu', (await items(page).count()) === 0);

  await pill(page).click();
  await items(page).nth(2).click();
  await page.waitForURL(`${origin}${BASE}/shibainu/#/3`);
  await page.waitForSelector('.demo-switcher-pill');
  t.ok('choosing an entry opens that theme at the same slide', where(page) === `${BASE}/shibainu/#/3`);
  t.ok('the pill now shows the new theme', (await pill(page).innerText()).trim() === 'shibainu');

  await pill(page).focus();
  await ctx.press(page, 'ArrowDown');
  await ctx.press(page, 'ArrowUp');
  await ctx.press(page, 'Enter', 600);
  await page.waitForURL(`${origin}${BASE}/seriph/#/3`);
  t.ok('the keyboard alone can switch themes', where(page) === `${BASE}/seriph/#/3`);

  await page.waitForSelector('.demo-switcher-pill');
  await ctx.press(page, 'o', 500);
  t.ok('the overview thumbnails have no pill', (await pill(page).count()) === 1);
  await ctx.press(page, 'Escape');

  await page.emulateMedia({ media: 'print' });
  t.ok('the pill is hidden in print', !(await pill(page).isVisible()));
  await page.emulateMedia({ media: 'screen' });
  t.ok('the pill is back on screen', await pill(page).isVisible());

  const print = await ctx.open(`${BASE}/seriph/#/3`.replace('#/3', '?print'), undefined, setup).catch(() => null);
  if (print) t.ok('the print view has no pill', (await print.locator('.demo-switcher-pill:visible').count()) === 0);

  t.ok('no console errors', ctx.problems.length === 0, ctx.problems.join(' | '));
} finally {
  await browser.close();
  server.close();
  rmSync(scratch, { recursive: true, force: true });
}
process.exit(t.done());
